# Files bundled into the source distribution (sdist) beyond the Python package
# itself. MAGeCK2 compiles the bundled RRA C++ helper from source at install
# time (see setup.py), so the sdist MUST carry the RRA sources, its Makefile,
# and the mageck2 launch script; otherwise `pip install mageck2` fails at
# `make` with nothing to compile.

# RRA C++ helper: Makefile, sources, and headers (compiled on install)
include rra/Makefile
recursive-include rra/src *.cpp *.h
recursive-include rra/include *.h
include rra/bin/.gitkeep
# The compiled helper is a data_files entry, which setuptools would otherwise
# pull into the sdist. A source distribution must not carry one platform's
# binary: exclude it so a local `python -m build` produces the same tarball as
# the release workflow, which builds from a never-compiled checkout.
exclude rra/bin/RRA

# mageckGSEA C++ helper: Makefile, sources, and headers, including the bundled
# TCLAP argument parser under gsea/src/tclap (compiled on install)
include gsea/Makefile
recursive-include gsea/src *.cpp *.h
include gsea/bin/.gitkeep
exclude gsea/bin/mageckGSEA

# CLI launch script installed onto PATH
include bin/mageck2

# Project metadata and docs
include LICENSE
include README.md
include CHANGELOG.md
include ROADMAP.md

# Test suite and its bundled data (lets the sdist be verified end to end)
recursive-include tests *.py
recursive-include tests/data *
